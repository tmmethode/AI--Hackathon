# HTTP port for the Express API and Swagger docs.
PORT=3001

# MongoDB connection string used by Mongoose at startup.
MONGODB_URI=mongodb://localhost:27017/ai-hackathon

# Standard Node environment flag used for cookies and runtime behavior.
NODE_ENV=development

# Secret used to sign access tokens for authenticated API requests.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Lifetime for issued JWTs, for example `7d` or `12h`.
JWT_EXPIRES_IN=7d

# Google OAuth client ID for "Sign in with Google".
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth client secret paired with the client ID above.
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Backend callback URL registered in the Google OAuth app.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Secret used by `express-session` to sign the session cookie.
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Frontend origin allowed by backend CORS and auth redirects.
FRONTEND_URL=http://localhost:3000

# Gemini API key required for screening, resume parsing, and AI assistant chat.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model name used across screening and assistant requests.
GEMINI_MODEL=gemini-2.5-flash-lite

# Base URL for the Google Generative Language REST API.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# Generic text generation output cap for assistant and non-batch Gemini calls.
GEMINI_MAX_OUTPUT_TOKENS=1200

# Default shortlist size shown when the frontend screening form first loads.
GEMINI_FRONTEND_DEFAULT_SHORTLIST_SIZE=10

# Minimum shortlist size the frontend allows the recruiter to choose.
GEMINI_FRONTEND_MIN_SHORTLIST_SIZE=5

# Maximum shortlist size the frontend allows the recruiter to choose.
GEMINI_FRONTEND_MAX_SHORTLIST_SIZE=50

# Number of applicants sent to Gemini together in one scoring chunk.
GEMINI_BATCH_CHUNK_SIZE=10

# Output token budget for one batch scoring response, separate from generic Gemini output.
GEMINI_BATCH_MAX_OUTPUT_TOKENS=32768

# Applicant count cap for the legacy synchronous `/gemini/screen-batch` endpoint only.
GEMINI_SCREEN_BATCH_MAX_APPLICANTS=200

# Number of ranked candidates grouped together for one explanation-generation request.
GEMINI_BATCH_NARRATIVE_CHUNK_SIZE=10

# Max scoring chunks processed in parallel inside one screening run.
GEMINI_BATCH_SCORING_CONCURRENCY=2

# Max narrative/explanation chunks processed in parallel inside one screening run.
GEMINI_BATCH_NARRATIVE_CONCURRENCY=2

# Per-request timeout before a Gemini call is treated as failed.
GEMINI_REQUEST_TIMEOUT_MS=90000

# Number of retries after a failed Gemini request.
GEMINI_MAX_RETRIES=2

# Base backoff delay in milliseconds between Gemini retries.
GEMINI_RETRY_BASE_DELAY_MS=600

# Number of applicants loaded from MongoDB at a time by the async screening worker.
GEMINI_ASYNC_DB_CHUNK_SIZE=20

# Max ranked results copied onto the shortlist document for fast UI reads.
GEMINI_PERSISTED_SCREENING_RESULT_LIMIT=500
